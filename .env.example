OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
PORT=3000
# Render: 1 only if exactly one trusted proxy is in front of the service.
TRUST_PROXY_HOPS=0
REQUESTS_PER_MINUTE=60
MAX_DAILY_REQUESTS=200
MAX_DAILY_TOKENS=2000000
# Use a persistent volume. A corrupt budget file fails closed.
BUDGET_FILE=./data/budget.json
